---
import BaseLayout from "../layouts/BaseLayout.astro";

const experience = [
  {
    company: "NewsBreak",
    role: "Software Engineer",
    dates: "2025 — Present",
    summary:
      "Ad Tech infrastructure, data pipelines, and tools that make complex systems easier to operate.",
  },
  {
    company: "QuantX",
    role: "Co-Founder & Lead Developer",
    dates: "2021 — 2024",
    summary:
      "Built an algorithmic trading platform, from financial data pipelines to investment tools. QuantX has also been invited to share quantitative trading with companies in Taiwan, including MediaTek.",
  },
  {
    company: "Trend AI",
    role: "Software Development Intern",
    dates: "2024",
    summary:
      "Built AI workflows for vulnerability prioritization and code review.",
  },
  {
    company: "OTSO Fintech",
    role: "Software Engineer",
    dates: "2022 — 2023",
    summary:
      "Developed trading services and tools with Go, Python, and distributed infrastructure.",
  },
];
---

<BaseLayout
  title="Resume"
  description="Tony Su’s experience in software engineering, Ad Tech, and fintech."
>
  <article class="page">
    <h1>Experience.</h1>
    <p class="resume-download">
      <a href="/resume.pdf" download>Download full resume ↗</a>
    </p>
    <section class="content-section" aria-labelledby="work-heading">
      <h2 id="work-heading">Work</h2>
      {
        experience.map((item) => (
          <section class="resume-entry" aria-label={item.company}>
            <header>
              <div>
                <>
                  <h3>{item.company}</h3>
                  <p>{item.role}</p>
                </>
              </div>
              <p>{item.dates}</p>
            </header>
            <p class="experience-summary">{item.summary}</p>
          </section>
        ))
      }
      <section class="resume-entry" aria-labelledby="soochow-heading">
        <header>
          <div>
            <h3 id="soochow-heading">Soochow University · Taiwan</h3>
            <p>Guest Lecturer · Quantitative Trading</p>
          </div>
        </header>
      </section>
      <section class="resume-entry" aria-labelledby="chideo-heading">
        <header>
          <div>
            <h3 id="chideo-heading">Chideo</h3>
            <p>Entrepreneurial project · Before QuantX</p>
          </div>
        </header>
        <p class="experience-summary">
          An online Chinese-language education platform.
        </p>
      </section>
    </section>
    <section class="content-section" aria-labelledby="education-heading">
      <h2 id="education-heading">Education &amp; learning</h2>
      <div class="resume-education">
        <div>
          <h3>University of Illinois Urbana-Champaign</h3><p>
            Master of Computer Science
          </p>
        </div><p>2024 — 2025</p>
      </div>
      <div class="resume-education">
        <div>
          <h3>National Yang Ming Chiao Tung University</h3><p>
            B.S. Computer Science
          </p>
        </div><p>2018 — 2022</p>
      </div>
      <div class="resume-education">
        <div>
          <h3>University of Southampton</h3>
          <p>
            Exchange studies · Blockchain and quantitative trading workshops
            with the Decentralised Society
          </p>
        </div>
      </div>
      <div class="resume-education">
        <div>
          <h3>42 · Bay Area</h3>
          <p>Piscine participant</p>
        </div>
        <p>2019</p>
      </div>
    </section>
  </article>
</BaseLayout>
