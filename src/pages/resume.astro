  description="Tony Su's software engineering experience, education, and technical skills."
>
  <article class="page">
    <p class="eyebrow">Resume</p>
    <h1>Tony Su</h1>
    <p class="lede">
      Software engineer building backend systems, data infrastructure, and AI
      products.
    </p>
    <ul class="resume-contact">
      <li>SF Bay Area, CA</li>
      <li><a href="mailto:boyusu18@outlook.com">boyusu18@outlook.com</a></li>
      <li><a href="tel:+14479027657">(447) 902-7657</a></li>
      <li><a href="https://www.linkedin.com/in/boyusu">LinkedIn</a></li>
    </ul>
    <p class="resume-download">
      <a href="/resume.pdf" download>Download resume (PDF)</a>
      <span>127 KB</span>
    </p>

    <section
      class="content-section resume-section"
      aria-labelledby="experience-heading"
    >
      <h2 id="experience-heading">Experience</h2>

