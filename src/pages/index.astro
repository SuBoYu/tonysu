---
import BaseLayout from "../layouts/BaseLayout.astro";
import PixelField from "../components/PixelField.astro";
import { SITE } from "../config";
---

<BaseLayout landing>
  <div class="landing">
    <p class="landing-location">
      <span aria-hidden="true">↗</span> Based in the Bay Area
    </p>
    <section class="landing-intro" aria-labelledby="intro-heading">
      <h1 id="intro-heading">Tony Su<span aria-hidden="true">.</span></h1>
      <p class="landing-description">
        Building things.<br />Following curiosity.
      </p>
    </section>
    <PixelField />
    <nav class="landing-links" aria-label="Explore">
      <a href="/about"
        ><span>01</span> The person <span aria-hidden="true">↗</span></a
      >
      <a href="/projects"
        ><span>02</span> The work <span aria-hidden="true">↗</span></a
      >
      <a href="/about#podcast"
        ><span>03</span> The conversations <span aria-hidden="true">↗</span></a
      >
    </nav>
    <footer class="landing-footer">
      <a href={`mailto:${SITE.email}`}>Say hello ↗</a>
      <div>
        <a href="/writing">Writing</a>
        <a href="https://www.threads.com/@tonysu05">Threads</a>
        <a href={SITE.linkedin}>LinkedIn</a>
      </div>
    </footer>
  </div>
</BaseLayout>
